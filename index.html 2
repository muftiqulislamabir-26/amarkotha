                media: "",
                likes: 16,
                comments: [],
                views: 42
            }
        ];

        let isAdmin = false;

        function renderPoems(poemsToRender = poems) {
            const container = document.getElementById('poemsContainer');
            container.innerHTML = '';

            poemsToRender.forEach((poem, index) => {
                const card = document.createElement('article');
                card.className = "bg-white/95 backdrop-blur-sm border border-amber-100 rounded-3xl p-6 sm:p-8 shadow-sm hover:shadow-md transition relative";
                
                let mediaHTML = '';
                if (poem.media) {
                    mediaHTML = `<div class="mt-4"><a href="${poem.media}" target="_blank" class="text-amber-700 hover:underline text-sm font-medium flex items-center gap-1.5">🎵 অডিও/ভিডিও শুনুন</a></div>`;
                }

                let adminActions = '';
                if (isAdmin) {
                    adminActions = `
                        <div class="absolute top-6 right-6 flex gap-2">
                            <button onclick="openEditModal(${index})" class="text-xs bg-amber-100 text-amber-800 px-3.5 py-1.5 rounded-xl hover:bg-amber-200 transition font-medium shadow-2xs">এডিট</button>
                            <button onclick="deletePoem(${index})" class="text-xs bg-rose-100 text-rose-800 px-3.5 py-1.5 rounded-xl hover:bg-rose-200 transition font-medium shadow-2xs">ডিলিট</button>
                        </div>
                    `;
                }

                card.innerHTML = `
                    ${adminActions}
                    <div class="mb-4 pr-24">
                        <h2 class="text-xl sm:text-2xl font-bold text-amber-950 mb-1.5">${poem.title}</h2>
                        <p class="text-xs sm:text-sm text-gray-500">${poem.date} • লেখক: <span class="text-amber-800 font-medium">${poem.author}</span></p>
                    </div>
                    <div class="poem-text text-gray-700 text-base mb-6 font-normal">${poem.content}</div>
                    ${mediaHTML}
                    <div class="border-t border-amber-100/60 pt-4 flex items-center justify-between text-xs sm:text-sm text-gray-500">
                        <div class="flex items-center gap-5">
                            <button onclick="likePoem(${index})" class="flex items-center gap-1.5 hover:text-amber-700 transition font-medium cursor-pointer">❤️ ${poem.likes} লাইক</button>
                            <span>👁️ ${poem.views} পঠিত</span>
                        </div>
                        <button onclick="toggleComments(${index})" class="hover:text-amber-700 font-medium cursor-pointer">💬 মন্তব্য (${poem.comments.length})</button>
                    </div>
                    <div id="commentsSection-${index}" class="hidden mt-4 pt-4 border-t border-gray-100">
                        <div class="space-y-2 mb-3 max-h-32 overflow-y-auto pr-2">
                            ${poem.comments.map(c => `<div class="bg-amber-50/70 p-2.5 rounded-xl text-xs text-gray-700 border border-amber-100/50">${c}</div>`).join('')}
                        </div>
                        <div class="flex gap-2">
                            <input type="text" id="commentInput-${index}" placeholder="আপনার মন্তব্য লিখুন..." class="flex-grow text-xs sm:text-sm px-3.5 py-2 border rounded-xl focus:outline-none focus:ring-1 focus:ring-amber-700 bg-gray-50/50">
                            <button onclick="addComment(${index})" class="bg-amber-800 text-white text-xs sm:text-sm px-4 py-2 rounded-xl hover:bg-amber-700 transition font-medium">মন্তব্য</button>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function filterPoems() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const filtered = poems.filter(p => p.title.toLowerCase().includes(query) || p.author.toLowerCase().includes(query) || p.content.toLowerCase().includes(query));
            renderPoems(filtered);
        }

        function openLoginModal() { document.getElementById('loginModal').classList.remove('hidden'); }
        function closeLoginModal() { document.getElementById('loginModal').classList.add('hidden'); }

        function handleLogin() {
            const u = document.getElementById('usernameInput').value;
            const p = document.getElementById('passwordInput').value;
            if (u === 'abir' && p === 'abir0404') {
                isAdmin = true;
                document.getElementById('auth-section').innerHTML = `<span class="text-xs font-semibold bg-emerald-800 text-white px-4 py-2 rounded-xl shadow-xs">অ্যাডমিন মোড সক্রিয়</span>`;
                document.getElementById('admin-controls').classList.remove('hidden');
                closeLoginModal();
                renderPoems();
            } else {
                alert(' ভুল ইউজারনেম বা পাসওয়ার্ড!');
            }
        }

        function openAddModal() {
            document.getElementById('modalTitle').innerText = "নতুন কবিতা যোগ করুন";
            document.getElementById('editIndex').value = "";
            document.getElementById('modalTitleInput').value = "";
            document.getElementById('modalDateInput').value = "";
            document.getElementById('modalAuthorInput').value = "";
            document.getElementById('modalContentInput').value = "";
            document.getElementById('modalMediaInput').value = "";
            document.getElementById('poemModal').classList.remove('hidden');
        }

        function openEditModal(index) {
            const p = poems[index];
            document.getElementById('modalTitle').innerText = "কবিতা এডিট করুন";
            document.getElementById('editIndex').value = index;
            document.getElementById('modalTitleInput').value = p.title;
            document.getElementById('modalDateInput').value = p.date;
            document.getElementById('modalAuthorInput').value = p.author;
            document.getElementById('modalContentInput').value = p.content;
            document.getElementById('modalMediaInput').value = p.media;
            document.getElementById('poemModal').classList.remove('hidden');
        }

        function closePoemModal() { document.getElementById('poemModal').classList.add('hidden'); }

        function savePoem() {
            const index = document.getElementById('editIndex').value;
            const title = document.getElementById('modalTitleInput').value;
            const date = document.getElementById('modalDateInput').value;
            const author = document.getElementById('modalAuthorInput').value;
            const content = document.getElementById('modalContentInput').value;
            const media = document.getElementById('modalMediaInput').value;

            if (!title || !content) {
                alert('অনুগ্রহ করে শিরোনাম ও মূল অংশ পূরণ করুন।');
                return;
            }

            if (index === "") {
                poems.push({ title, date, author, content, media, likes: 0, comments: [], views: 1 });
            } else {
                poems[index].title = title;
                poems[index].date = date;
                poems[index].author = author;
                poems[index].content = content;
                poems[index].media = media;
            }

            closePoemModal();
            renderPoems();
        }

        function deletePoem(index) {
            if (confirm('আপনি কি নিশ্চিতভাবে এই কবিতাটি ডিলিট করতে চান?')) {
                poems.splice(index, 1);
                renderPoems();
            }
        }

        function likePoem(index) {
            poems[index].likes++;
            renderPoems();
        }

        function toggleComments(index) {
            const sec = document.getElementById(`commentsSection-${index}`);
            sec.classList.toggle('hidden');
        }

        function addComment(index) {
            const input = document.getElementById(`commentInput-${index}`);
            if (input.value.trim()) {
                poems[index].comments.push(input.value.trim());
                renderPoems();
                document.getElementById(`commentsSection-${index}`).classList.remove('hidden');
            }
        }

        window.onload = () => renderPoems();
    </script>
</body>
